<?xml version="1.0" encoding="utf-8"?>
<!--
    Security Groups for hr_training_request

    Hierarchy (cumulative — each group inherits all permissions of the one below):
        hr.group_hr_user
            └── group_training_requester  (base: all employees)
                    └── group_training_manager  (first-stage approver)
                            └── group_training_hr  (final approver, company-wide)

    Rationale:
      - Inheritance via implied_ids means HR always has all Manager capabilities,
        and Manager always has all Requester capabilities.
      - This simplifies ACL management: no need to duplicate entries.
      - UX tradeoff (HR technically CAN see Submit button): mitigated by
        XML attrs checking employee ownership + Python guard enforcing it.
-->
<odoo>
    <data noupdate="1">

        <record id="group_training_requester" model="res.groups">
            <field name="name">Training Requester</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="comment">
                Base training group. Allows employees to create, edit, submit,
                and cancel their own training requests. Can only see their own records.
            </field>
        </record>

        <record id="group_training_manager" model="res.groups">
            <field name="name">Training Manager Approver</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_training_requester'))]"/>
            <field name="comment">
                First-stage approver. Can approve or reject training requests submitted
                by their direct reports. Can see own requests plus direct reports' requests.
            </field>
        </record>

        <record id="group_training_hr" model="res.groups">
            <field name="name">Training HR Approver</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_training_manager'))]"/>
            <field name="comment">
                Final approver. Company-wide visibility of all training requests.
                Can give final approval or rejection. Has exclusive access to the
                HR Notes field. Inherits all Manager and Requester capabilities.
            </field>
        </record>

    </data>
</odoo>
